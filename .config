
#
# RESNET_TEST
#
# CONFIG_RESNET_ADD_P32 is not set
# CONFIG_RESNET_SUB_P32 is not set
# CONFIG_RESNET_MUL_P32 is not set
# CONFIG_RESNET_DIV_P32 is not set
# CONFIG_RESNET_DOT_P32 is not set
# CONFIG_RESNET_FP32_TO_POSIT32 is not set
# CONFIG_RESNET_POSIT32_TO_FP32 is not set
# CONFIG_RESNET_POSIT32_TO_FP4 is not set
# CONFIG_RESNET_POSIT32_TO_FP8 is not set
# CONFIG_RESNET_POSIT32_TO_FP16 is not set
# CONFIG_RESNET_GREATER_P32 is not set
# CONFIG_RESNET_LESS_P32 is not set
# CONFIG_RESNET_TRUNCATE_P32 is not set
# CONFIG_PVU_PROTOCOL_REGRESSION is not set
# CONFIG_PVU_MAC_REGRESSION is not set
CONFIG_LLM_P32_MAC_WORKLOAD=y
# CONFIG_LLM_P32_CONVERSION_WORKLOAD is not set
# CONFIG_LLM_P32_DOT_WORKLOAD is not set
# CONFIG_LLM_P32_MUL_WORKLOAD is not set
# CONFIG_LLM_P32_TO_INT_WORKLOAD is not set
# CONFIG_MATRIX_GEMM_P32_BENCHMARK is not set
# CONFIG_MATRIX_GEMM_P32_PRESET_TAIL_K1 is not set
CONFIG_MATRIX_GEMM_P32_PRESET_TAIL_K2=y
# CONFIG_MATRIX_GEMM_P32_PRESET_TAIL_K3 is not set
# CONFIG_MATRIX_GEMM_P32_PRESET_TAIL_K4 is not set
# CONFIG_MATRIX_GEMM_P32_PRESET_TAIL_K5 is not set
# CONFIG_MATRIX_GEMM_P32_PRESET_SQUARE_16 is not set
# CONFIG_MATRIX_GEMM_P32_PRESET_SQUARE_32_K63 is not set
# CONFIG_MATRIX_GEMM_P32_PRESET_SQUARE_32_K64 is not set
# CONFIG_MATRIX_GEMM_P32_PRESET_SQUARE_32_K65 is not set
# CONFIG_MATRIX_GEMM_P32_PRESET_GEMV_ROW is not set
# CONFIG_MATRIX_GEMM_P32_PRESET_GEMV_COLUMN is not set
# CONFIG_MATRIX_GEMM_P32_PRESET_WIDE is not set
# CONFIG_MATRIX_GEMM_P32_PRESET_TALL is not set
# CONFIG_MATRIX_GEMM_P32_PRESET_CUBE_64 is not set
# CONFIG_MATRIX_GEMM_P32_PRESET_CUBE_128 is not set
CONFIG_MATRIX_GEMM_P32_M=2
CONFIG_MATRIX_GEMM_P32_N=3
CONFIG_MATRIX_GEMM_P32_K=2
# CONFIG_LLM_P32_PROFILE_QWEN3_0_6B is not set
CONFIG_LLM_P32_PROFILE_GEMMA3_1B=y
# CONFIG_LLM_P32_PROFILE_PHI4_MINI is not set
CONFIG_LLM_P32_MODEL_DIR="/root/models/gemma-3-1b-it"
CONFIG_LLM_P32_AUTO_EXPORT_TRACE=y
CONFIG_LLM_P32_MAC_TRACE_DIR="/tmp/gemma-3-1b-p32-trace"
# end of RESNET_TEST

