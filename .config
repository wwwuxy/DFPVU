# CONFIG_RESNET_ADD_P32 is not set
# CONFIG_RESNET_SUB_P32 is not set
# CONFIG_RESNET_MUL_P32 is not set
# CONFIG_RESNET_DIV_P32 is not set
# CONFIG_RESNET_DOT_P32 is not set
# CONFIG_RESNET_FP32_TO_POSIT32 is not set
# CONFIG_RESNET_POSIT32_TO_FP32 is not set
# CONFIG_RESNET_POSIT32_TO_FP4 is not set
# CONFIG_RESNET_POSIT32_TO_FP8 is not set
# CONFIG_RESNET_POSIT32_TO_FP16 is not set
# CONFIG_RESNET_GREATER_P32 is not set
# CONFIG_RESNET_LESS_P32 is not set
# CONFIG_RESNET_TRUNCATE_P32 is not set
# CONFIG_PVU_PROTOCOL_REGRESSION is not set
# CONFIG_PVU_MAC_REGRESSION is not set
# CONFIG_LLM_P32_MAC_WORKLOAD is not set
# CONFIG_LLM_P32_CONVERSION_WORKLOAD is not set
# CONFIG_LLM_P32_TO_P16_WORKLOAD is not set
# CONFIG_LLM_P32_DOT_WORKLOAD is not set
CONFIG_LLM_P32_MUL_WORKLOAD=y
# CONFIG_LLM_P32_TO_INT_WORKLOAD is not set
# CONFIG_LLM_P32_ADD_WORKLOAD is not set
# CONFIG_MATRIX_GEMM_P32_BENCHMARK is not set
# CONFIG_LLM_P32_PROFILE_QWEN3_0_6B is not set
# CONFIG_LLM_P32_PROFILE_GEMMA3_1B is not set
CONFIG_LLM_P32_PROFILE_PHI4_MINI=y
CONFIG_LLM_P32_PATH_MODE_PROFILE_DEFAULTS=y
# CONFIG_LLM_P32_PATH_MODE_CUSTOM is not set
CONFIG_LLM_P32_AUTO_EXPORT_TRACE=y
CONFIG_LLM_P32_MUL_SAMPLES_256=y
# CONFIG_LLM_P32_MUL_SAMPLES_1024 is not set
# CONFIG_LLM_P32_MUL_SAMPLES_4096 is not set
CONFIG_LLM_P32_MUL_SAMPLE_COUNT=256
# end of RESNET_TEST

