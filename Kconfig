    string "Custom LLM P32 trace directory"
    default ""
    help
        Override the selected profile's standard linear trace directory.

endif

endif

config LLM_P32_AUTO_EXPORT_TRACE
    bool "Automatically export a missing LLM trace"
    default y
    help
        On the first make run, export a layer-0 attention projection from the
        selected local model into the trace directory. Export is offline and
        uses 128 tokens, covering every supplied MNK preset. Existing traces
        are not overwritten. Disable this to require a manually exported
        trace instead.

if LLM_P32_CONVERSION_WORKLOAD || LLM_P32_TO_P16_WORKLOAD

choice
    prompt "LLM conversion trace tensor"
    default LLM_P32_CONVERSION_TENSOR_INPUT
    help
        Select the real tensor distribution replayed by the op=7 conversion
        workload. Input and output are activations; weight is the projection
        parameter distribution.

config LLM_P32_CONVERSION_TENSOR_INPUT
    bool "Layer input activation"

config LLM_P32_CONVERSION_TENSOR_WEIGHT
    bool "Projection weight"

config LLM_P32_CONVERSION_TENSOR_OUTPUT
    bool "Linear output activation"

endchoice

config LLM_P32_CONVERSION_TENSOR
    string
    default "input" if LLM_P32_CONVERSION_TENSOR_INPUT
    default "weight" if LLM_P32_CONVERSION_TENSOR_WEIGHT
    default "output" if LLM_P32_CONVERSION_TENSOR_OUTPUT

choice
    prompt "LLM conversion samples per module"
    default LLM_P32_CONVERSION_SAMPLES_256
    help
        Select a deterministic, evenly spaced number of scalar elements from
        each exported module tensor. A tensor smaller than the selection is
        replayed in full without duplicate samples.

config LLM_P32_CONVERSION_SAMPLES_256
    bool "256 elements"

config LLM_P32_CONVERSION_SAMPLES_1024
    bool "1024 elements"

config LLM_P32_CONVERSION_SAMPLES_4096
    bool "4096 elements"

endchoice


config LLM_P32_CONVERSION_SAMPLE_COUNT
    int
    range 1 65536
    default 256 if LLM_P32_CONVERSION_SAMPLES_256
    default 1024 if LLM_P32_CONVERSION_SAMPLES_1024
    default 4096 if LLM_P32_CONVERSION_SAMPLES_4096

endif

if LLM_P32_DOT_WORKLOAD

