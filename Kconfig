mainmenu "Test File Config"

menu "RESNET_TEST"
    choice
        prompt "Posit<32, 2>"
        default RESNET_ADD_P32
        depends on !SAMPLE_TEST  # 新增依赖：仅在SAMPLE_TEST未启用时可见
        help
            Select one of the ResNet operations for the test.

    config RESNET_ADD_P32
        bool "resnet_add_p32_test"
        default n
        help
            Enable ResNet addition test.

    config RESNET_SUB_P32
        bool "resnet_sub_p32_test"
        default n
        help
            Enable ResNet subtraction test.

    config RESNET_MUL_P32
        bool "resnet_mul_p32_test"
        default n
        help
            Enable ResNet multiplication test.

    config RESNET_DIV_P32
        bool "resnet_div_p32_test"
        default n
        help
            Enable ResNet division test.

    config RESNET_DOT_P32
        bool "resnet_dot_p32_test"
        default n
        help
            Enable ResNet dot product test. 

    config RESNET_FP32_TO_POSIT32
        bool "resnet_fp32_to_posit32_test"
        default n
        help
            Enable IEEE-754 FP32 to Posit32 conversion test.
            
    config RESNET_POSIT32_TO_FP32
        bool "resnet_posit32_to_fp32_test"
        default n
        help
            Enable Posit32 to IEEE-754 FP32 conversion test.

    config RESNET_POSIT32_TO_FP4
        bool "resnet_posit32_to_fp4_precision_batch_test"
        default n
        help
            Enable Posit32 to FP4 batch conversion and precision-loss report.

    config RESNET_POSIT32_TO_FP8
        bool "resnet_posit32_to_fp8_precision_batch_test"
        default n
        help
            Enable Posit32 to FP8 batch conversion and precision-loss report.

    config RESNET_POSIT32_TO_FP16
        bool "resnet_posit32_to_fp16_precision_batch_test"
        default n
        help
            Enable Posit32 to FP16 batch conversion and precision-loss report.
            
    config RESNET_GREATER_P32
        bool "resnet_greater_p32_test"
        default n
        help
            Enable Posit32 greater comparison test.

    config RESNET_LESS_P32
        bool "resnet_less_p32_test"
        default n
        help
            Enable Posit32 less comparison test.

    config RESNET_TRUNCATE_P32
        bool "resnet_truncate_p32_test"
        default n
        help
            Enable Posit32 to Int32 truncation test.

    config PVU_PROTOCOL_REGRESSION
        bool "pvu_protocol_exact_reference_regression"
        default n
        help
            Run the operation-complete, exact SoftPosit reference regression.
            This is the baseline driver for the tagged ready/valid protocol.

    config PVU_MAC_REGRESSION
        bool "pvu_mac_exact_reference_regression"
        default n
        help
            Run the Posit32 MAC regression: c + sum(a[i] * b[i]).
            Uses the existing tagged ready/valid protocol and SoftPosit oracle.

    config QWEN3_P32_MAC_WORKLOAD
        bool "qwen3_p32_mac_workload"
        default n
        help
            Replay selected Qwen3 linear-output elements through the Posit32
            MAC datapath and report Verilator workload numerical loss and
            utilization metrics.

    config MATRIX_GEMM_P32_BENCHMARK
        bool "matrix_gemm_p32_throughput_benchmark"
        default n
        help
            Run one deterministic Posit32 GEMM MxK times KxN benchmark.
            The runner reports cycle-level throughput and verifies every
            output against the SoftPosit MAC recurrence.

    endchoice

config QWEN3_P32_MAC_TRACE_DIR
    string "Qwen3 P32 MAC trace directory"
    depends on QWEN3_P32_MAC_WORKLOAD
    default "/tmp/qwen3-0.6b-p32-trace"
    help
        Trace generated from Qwen3-0.6B. This workload never falls back to
        the fixture; make run reports an error when this directory is invalid.

endmenu

config SAMPLE_TEST
    bool "manually_sample_test"
    default n