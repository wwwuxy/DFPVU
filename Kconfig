    default 4096 if LLM_P32_DOT_SAMPLES_4096

endif
if LLM_P32_MUL_WORKLOAD

choice
    prompt "LLM Multiply samples per module"
    default LLM_P32_MUL_SAMPLES_256
    help
        Select a deterministic, evenly spaced number of four-element
        input-times-weight vectors from each exported linear module. Each
        vector becomes one four-lane P32 multiply request; a smaller module
        is replayed in full without duplicate samples.

config LLM_P32_MUL_SAMPLES_256
    bool "256 Multiply vectors"

config LLM_P32_MUL_SAMPLES_1024
    bool "1024 Multiply vectors"

